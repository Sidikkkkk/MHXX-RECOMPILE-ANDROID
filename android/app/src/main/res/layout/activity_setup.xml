<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONSTER HUNTER XX"
            android:textColor="#E0A938"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native Android Port Setup"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Card ROM 3DS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. File Game ROM (.3ds / .cia)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rom_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum ada file dipilih"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_select_rom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH FILE ROM (.3DS / .CIA)"
                android:backgroundTint="#2D5A88"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Card Update CIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. File Update v1.4.0 (Opsional .cia)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tidak ada update (akan menggunakan versi dasar)"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_select_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH UPDATE V1.4.0 (.CIA)"
                android:backgroundTint="#3A3A3A"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Progress Extraction -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminate="false"
            android:max="100"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mengekstrak aset game..."
            android:textColor="#E0A938"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Tombol Eksekusi -->
        <Button
            android:id="@+id/btn_install_and_play"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INSTALL ASET &amp; MAINKAN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#C4841D"
            android:textColor="#FFFFFF"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>

